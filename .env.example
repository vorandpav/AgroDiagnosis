APP_NAME=agrodiagnosis
VERSION=0.1.0
LOG_LEVEL=INFO
DEBUG=false
ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/agrodiagnosis
MLFLOW_TRACKING_URI=http://host.docker.internal:5000
MLFLOW_MODEL_NAME=agrodiagnosis-plant-disease
MLFLOW_MODEL_ALIAS=champion

TZ=Europe/Moscow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agrodiagnosis
POSTGRES_PORT=5433
APP_PORT=8000
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
TASK_QUEUE=agrodiagnosis.inference.v1
TASK_STORAGE_DIR=task-data
INFERENCE_MIN_SECONDS=1.0
PUBLISH_TIMEOUT_SECONDS=5.0
BATCH_MANIFEST=/data/demo/tasks.jsonl
