APP_NAME=agrodiagnosis
VERSION=0.1.0
LOG_LEVEL=INFO
DEBUG=false
ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/agrodiagnosis
MLFLOW_TRACKING_URI=http://host.docker.internal:5000
MLFLOW_MODEL_NAME=agrodiagnosis-plant-disease
MLFLOW_MODEL_ALIAS=champion

TZ=Europe/Moscow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agrodiagnosis
POSTGRES_PORT=5433
APP_PORT=8000
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
TASK_QUEUE=agrodiagnosis.inference.v1
EVALUATE_TASK_QUEUE=agrodiagnosis.evaluate.v1
TASK_QUEUE_MAX_LENGTH=100
TASK_QUEUE_SOFT_LIMIT=60
TASK_STORAGE_DIR=task-data
INFERENCE_MIN_SECONDS=1.0
PUBLISH_TIMEOUT_SECONDS=5.0
PUBLISH_RETRY_DELAY_SECONDS=0.5
TASK_MAX_DELIVERY_ATTEMPTS=3
TASK_RETRY_DELAY_SECONDS=1.0
EVALUATION_TIMEOUT_SECONDS=120
WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=8001
WORKER_HEALTH_URL=http://127.0.0.1:8001/healthz
WORKER_EXECUTOR_WORKERS=1

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_SDK_DISABLED=false
OTEL_BSP_SCHEDULE_DELAY=1000
OTEL_BSP_EXPORT_TIMEOUT=2000
OTEL_METRIC_EXPORT_INTERVAL=5000
WORKER_INSTANCE_ID=inference-worker

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=agrodiagnosis