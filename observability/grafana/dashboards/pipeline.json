        "legend": { "calcs": ["mean", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "expr": "sum(rate(source_tasks_published_total[5m])) or vector(0)",
          "legendFormat": "source publish",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "expr": "sum(rate(api_requests_total{route=\"/api/v1/tasks\",status=\"202\"}[5m])) or vector(0)",
          "legendFormat": "API accept (202)",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "expr": "sum(rate(worker_task_outcomes_total{instance=~\"$instance\"}[5m])) or vector(0)",
          "legendFormat": "worker total",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "expr": "sum(rate(worker_task_outcomes_total{instance=~\"$instance\"}[5m])) by (instance)",
          "legendFormat": "worker {{instance}}",
          "range": true,
          "refId": "D"
        }
      ],
      "title": "Publish vs worker throughput",
      "type": "timeseries"
    },
